# ==========================================
# Этап 1: Сборка Frontend (Svelte 5 + Vite)
# ==========================================
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
COPY frontend/common ./common
COPY frontend/apps/replicator/package*.json ./apps/replicator/
RUN npm ci --workspace=apps/replicator --include-workspace-root

COPY frontend/apps/replicator ./apps/replicator
RUN npm run build --workspace=apps/replicator

# ==========================================
# Этап 2: Hadoop gRPC Replicator Backend
# ==========================================
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libkrb5-dev \
    libkrb5-3 \
    krb5-user \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Установка зависимостей
COPY backend/common /app/backend/common
COPY backend/replicator /app/backend/replicator
COPY --from=frontend-builder /app/backend/replicator/orchestrator/static /app/backend/replicator/orchestrator/static

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        fastapi>=0.115.0 \
        uvicorn[standard]>=0.30.0 \
        pydantic>=2.8.0 \
        sqlalchemy>=2.0.32 \
        grpcio>=1.62.0 \
        grpcio-tools>=1.62.0 \
        protobuf>=4.25.0 \
        prometheus-client>=0.20.0 \
        httpx>=0.27.0 \
        pyarrow>=17.0.0 \
        pyjwt>=2.8.0 \
        pyyaml>=6.0.0

# Компиляция proto-файлов внутри контейнера
RUN python -m grpc_tools.protoc \
    -I /app/backend/replicator/proto \
    --python_out=/app/backend/replicator/generated \
    --grpc_python_out=/app/backend/replicator/generated \
    /app/backend/replicator/proto/replicator.proto && \
    sed -i -e 's/^import replicator_pb2 as/from . import replicator_pb2 as/g' /app/backend/replicator/generated/replicator_pb2_grpc.py

RUN pip install --no-cache-dir --no-deps /app/backend/common /app/backend/replicator

ENV PYTHONPATH="/app:/app/backend:/app/backend/replicator"

EXPOSE 8005 50051

CMD ["uvicorn", "backend.replicator.orchestrator.main:app", "--host", "0.0.0.0", "--port", "8005"]
