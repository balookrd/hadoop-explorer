# =========================================================================
# Hadoop gRPC Replicator :: Orchestrator (Java 21 / Spring Boot 3)
# =========================================================================
FROM eclipse-temurin:21-jre-jammy

RUN apt-get update && apt-get install -y --no-install-recommends \
    krb5-user \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копирование собранного Spring Boot Fat JAR
COPY backend/replicator/orchestrator/target/replicator-orchestrator-1.0.0.jar /app/replicator-orchestrator.jar

# Копирование собранного Frontend SPA (Svelte 5)
COPY backend/replicator/orchestrator/src/main/resources/static /app/frontend/dist

# Создание непривилегированного пользователя appuser (UID 10001)
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -m -s /bin/bash appuser && \
    mkdir -p /app/data /etc/security/keytabs /app/config && \
    touch /etc/krb5.conf && \
    chown -R appuser:appuser /app /etc/krb5.conf /etc/security/keytabs

ENV APP_NAME="replicator-orchestrator" \
    FRONTEND_DIST="/app/frontend/dist" \
    SERVER_PORT="8005"

# Запуск от root для совместимости с монтируемыми томами данных
EXPOSE 8005

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8005/health || curl -f http://localhost:8005/actuator/health || exit 1

ENTRYPOINT ["java", "-Xms256m", "-Xmx1024m", "-jar", "/app/replicator-orchestrator.jar"]
