<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.hadoop.explorer</groupId>
    <artifactId>replicator-model</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Hadoop gRPC Replicator :: Model</name>
    <description>Общие для агента и оркестратора DTO, enum-ы и контракты: модель задач, HMS-модель, аттестация задач, gRPC-перехватчик агента</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <grpc.version>1.68.1</grpc.version>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <protobuf.version>3.25.5</protobuf.version>
        <opentelemetry.version>1.37.0</opentelemetry.version>
        <junit.version>5.11.0</junit.version>
        <mockito.version>5.13.0</mockito.version>
    </properties>

    <!--
        Модуль держат нарочно тонким: никаких Hadoop, Hive Thrift и Kafka-клиентов.
        Он попадает в classpath и агента, и оркестратора, поэтому любая тяжелая
        зависимость здесь сразу расползается на оба сервиса. Из gRPC здесь только
        grpc-api и grpc-services (стандартный health-протокол), из телеметрии —
        opentelemetry-api: сам SDK и экспортер подключает каждый сервис сам.
    -->
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- grpc-api: перехватчик аутентификации агента -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- grpc-services: стандартный health-протокол grpc.health.v1 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- Сообщения health-протокола сгенерированы protobuf -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <!-- Только API трассировки: без SDK это no-op и ничего не стоит -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- In-process транспорт: health-протокол проверяется через настоящий gRPC-сервер -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Реализация логирования нужна тестам: у голого slf4j-api MDC — заглушка,
             а trace_id в MDC и есть то, что связывает логи процессов в одну операцию -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.8</version>
            <scope>test</scope>
        </dependency>

        <!-- Настоящий SDK только в тестах: спаны проверяются через InMemorySpanExporter -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${opentelemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <version>${opentelemetry.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Прогоны и сборка идут на Java 21 LTS — платформе проекта и CI. На JDK 24 и новее
                Hadoop 3.3.6 теряет имперсонацию: `Subject.getSubject` бросает
                UnsupportedOperationException (JEP 486, Security Manager удален), а
                `UserGroupInformation.getCurrentUser()` внутри `doAs` идет через него. Отключить
                это флагом нельзя — `-Djava.security.manager=allow` на таких JDK не дает
                стартовать VM. Поэтому зеленый прогон на более новом рантайме ничего не говорит
                о продакшене, и сборку на нем лучше остановить сразу.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Build and test the replicator on Java 21 LTS: on JDK 24+ Hadoop 3.3.6 loses impersonation (Subject.getSubject throws UnsupportedOperationException after JEP 486) and -Djava.security.manager=allow no longer starts the VM, so a green run there says nothing about production. Use: make test-replicator (or JAVA_HOME=&lt;jdk21&gt; mvn ...)</message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true</argLine>
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
