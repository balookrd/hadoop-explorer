<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!-- Хранилище метаданных (Apache Derby) -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=metastore_cluster2_db;create=true</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.apache.derby.jdbc.EmbeddedDriver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>APP</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>mine</value>
  </property>

  <!-- URI сервиса метастора кластера 2 -->
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore-2:9083</value>
  </property>
  <property>
    <name>hive.metastore.execute.setugi</name>
    <value>false</value>
  </property>

  <!-- Хранилище таблиц кластера 2 -->
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/opt/hive/warehouse</value>
  </property>
  <property>
    <name>fs.defaultFS</name>
    <value>file:///</value>
  </property>

  <!-- Kerberos аутентификация для HiveServer2 -->
  <property>
    <name>hive.server2.authentication</name>
    <value>KERBEROS</value>
  </property>
  <property>
    <name>hive.server2.authentication.kerberos.principal</name>
    <value>hive/hive-server-2@COMPANY.LOCAL</value>
  </property>
  <property>
    <name>hive.server2.authentication.kerberos.keytab</name>
    <value>/etc/security/keytabs/hive.keytab</value>
  </property>
  <property>
    <name>hive.metastore.kerberos.principal</name>
    <value>hive/hive-server-2@COMPANY.LOCAL</value>
  </property>
  <property>
    <name>hive.metastore.kerberos.keytab.file</name>
    <value>/etc/security/keytabs/hive.keytab</value>
  </property>

  <!-- Включение doAs имперсонации -->
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>

  <!-- Порты и транспорт HiveServer2 -->
  <property>
    <name>hive.server2.thrift.port</name>
    <value>10001</value>
  </property>
  <property>
    <name>hive.server2.thrift.bind.host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>hive.security.authorization.enabled</name>
    <value>false</value>
  </property>
</configuration>
