      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sql_query_duration_seconds_bucket[5m])) by (le, engine))",
          "legendFormat": "p95 Latency ({{engine}})",
          "refId": "A"
        }
      ],
      "title": "SQL Query Latency (p95)",
      "type": "timeseries"
