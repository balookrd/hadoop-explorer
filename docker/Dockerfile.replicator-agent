FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

# Установка базовых утилит
RUN apt-get update && apt-get install -y --no-install-recommends \
    krb5-user \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Создание директорий для данных и staging и непривилегированного пользователя:
# агент распаковывает TAR-бандлы из сети, поэтому не должен работать от root.
RUN mkdir -p /tmp/staging /tmp/data /app/data && \
    groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -m -s /bin/bash appuser && \
    touch /etc/krb5.conf && \
    chown -R appuser:appuser /tmp/staging /tmp/data /app /etc/krb5.conf

# Копирование собранного Shaded Fat JAR Java Replicator Agent
COPY backend/replicator/agent/target/replicator-agent-1.0.0-all.jar /app/replicator-agent.jar

USER appuser

EXPOSE 50051 50052 50053

# Проба по стандартному health-протоколу gRPC тем же jar-ом, что и сам агент:
# прежняя проверка открывала TCP-соединение, и агент с незапущенным или уже
# остановленным приемником ее проходил.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD java -XX:TieredStopAtLevel=1 -Xshare:auto -cp /app/replicator-agent.jar \
        org.apache.hadoop.explorer.replicator.telemetry.GrpcHealthProbeMain \
        127.0.0.1:${RECEIVER_PORT:-50051} || exit 1


# После OutOfMemoryError JVM завершается: OOM убивал поток heartbeat, и агент оставался
# зомби, которого оркестратор снимал с задач. Перезапуск отдается супервизору.
ENTRYPOINT ["java", "-Xms256m", "-Xmx1024m", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/replicator-agent.jar"]
