<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>org.apache.hadoop.explorer</groupId>
    <artifactId>replicator-orchestrator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Hadoop gRPC Replicator :: Orchestrator</name>
    <description>Оркестратор Hadoop gRPC Replicator: управление задачами репликации, топологией ЦОД и Token Bucket троттлером</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
        <grpc.version>1.68.1</grpc.version>
    </properties>

    <dependencies>
        <!-- Common Security Starter (Auth, Kerberos, LDAP, JWT, SessionStore) -->
        <dependency>
            <groupId>org.apache.hadoop.explorer</groupId>
            <artifactId>common-security-starter</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Общие wire-контракты: control plane и data plane .proto -->
        <dependency>
            <groupId>org.apache.hadoop.explorer</groupId>
            <artifactId>replicator-proto</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Общие с агентом DTO, HMS-модель, аттестация задач -->
        <dependency>
            <groupId>org.apache.hadoop.explorer</groupId>
            <artifactId>replicator-model</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- gRPC Netty & Protobuf -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <!-- Трассировка: micrometer-tracing на OpenTelemetry. Экспорт в OTLP включается
             заданием management.otlp.tracing.endpoint; без него спаны не уходят никуда,
             но trace_id в логах и traceparent в вызовах gRPC работают -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Миграции схемы: единственный источник DDL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Database Support: H2, SQLite, PostgreSQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- InMemorySpanExporter: проверка, что спаны вызовов gRPC действительно создаются -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The orchestrator must never link against the agent. The agent carries the
                Hadoop, Hive Thrift and Kafka client stacks plus its own runtime; pulling it
                into the control plane put all of that on the orchestrator's classpath and
                let a change meant for one node break the other. Shared wire contracts live
                in replicator-proto and replicator-model instead.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!--
                        Прогоны и сборка идут на Java 21 LTS — платформе проекта и CI. На JDK 24
                        и новее Hadoop 3.3.6 теряет имперсонацию (`Subject.getSubject` бросает
                        UnsupportedOperationException после удаления Security Manager, JEP 486),
                        и отключить это флагом нельзя: `-Djava.security.manager=allow` не дает
                        стартовать VM. Зеленый прогон на новом рантайме ничего не говорит о
                        продакшене.
                    -->
                    <execution>
                        <id>require-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Build and test the replicator on Java 21 LTS: on JDK 24+ Hadoop 3.3.6 loses impersonation (Subject.getSubject throws UnsupportedOperationException after JEP 486) and -Djava.security.manager=allow no longer starts the VM, so a green run there says nothing about production. Use: make test-replicator (or JAVA_HOME=&lt;jdk21&gt; mvn ...)</message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                    <execution>
                        <id>ban-agent-dependency</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.hadoop.explorer:replicator-agent</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>replicator-orchestrator must not depend on replicator-agent: share code through replicator-proto / replicator-model</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
