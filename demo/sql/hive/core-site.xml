<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://hdfs-cluster-1:9000</value>
  </property>

  <property>
    <name>hadoop.security.authentication</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>ipc.client.fallback-to-simple-auth-allowed</name>
    <value>true</value>
  </property>
  <property>
    <name>hadoop.security.auth_to_local</name>
    <value>
      RULE:[2:$1@$0](.*@COMPANY.LOCAL)s/@.*//
      RULE:[1:$1@$0](.*@COMPANY.LOCAL)s/@.*//
      DEFAULT
    </value>
  </property>

  <property>
    <name>dfs.namenode.kerberos.principal</name>
    <value>nn/hdfs-cluster-1.demo-platform-net@COMPANY.LOCAL</value>
  </property>

  <property>
    <name>dfs.data.transfer.protection</name>
    <value>integrity</value>
  </property>

  <property>
    <name>mapreduce.jobhistory.principal</name>
    <value>hive/hive-server@COMPANY.LOCAL</value>
  </property>

  <!-- Разрешение сервисному аккаунту svc_sql_explorer делать doAs от имени аналитиков -->
  <property>
    <name>hadoop.proxyuser.svc_sql_explorer.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.svc_sql_explorer.groups</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hive.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hive.groups</name>
    <value>*</value>
  </property>
</configuration>
